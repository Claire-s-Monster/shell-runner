[Unit]
Description=Shell Runner MCP HTTP Server
Documentation=https://github.com/MementoRC/shell-runner
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/memento/ClaudeCode/Servers/shell-runner
Environment=SHELL_RUNNER_DB=/home/memento/.local/share/shell-runner/telemetry.sqlite3
Environment=SHELL_RUNNER_HOST=127.0.0.1
Environment=SHELL_RUNNER_PORT=4111
Environment=PYTHONPATH=/home/memento/ClaudeCode/Servers/shell-runner/src
ExecStart=/home/memento/.conda/envs/ClaudeCode/bin/pixi run --manifest-path /home/memento/ClaudeCode/Servers/shell-runner/pyproject.toml --environment ci uvicorn shell_runner.server:app --host 127.0.0.1 --port 4111
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
